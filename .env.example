# =====================================================================
# Lógica Visual ABP · Variables de Entorno (Plantilla)
# Copia este archivo a .env y ajusta los valores de tu entorno.
# =====================================================================

# Configuración de Aplicación
APP_NAME="Lógica Visual ABP"
APP_ENV=local
APP_DEBUG=true
APP_BASE_PATH=
APP_TIMEZONE=America/Monterrey
LOG_PATH=

# Sesión (tiempo de inactividad en segundos: 7200 = 2 horas)
SESSION_IDLE_LIFETIME=7200

# Base de Datos Local (XAMPP):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cursos
DB_USERNAME=root
DB_PASSWORD=""
DB_SSL_CA=""
DB_SSL_VERIFY=true
DB_TIMEOUT=5

# Base de Datos en la Nube (Windows Azure - MySQL Flexible Server):
# Descomenta y sustituye al momento de migrar a Azure:
# DB_HOST=cursos-servidor.mysql.database.azure.com
# DB_PORT=3306
# DB_DATABASE=cursos
# DB_USERNAME=admincursos
# DB_PASSWORD="TuContrasenaSeguraAzure"
# DB_SSL_CA="C:/xampp/htdocs/Cursos/docs/database/DigiCertGlobalRootCA.crt.pem"
# DB_SSL_VERIFY=true
# APP_ENV=production
# APP_DEBUG=false
