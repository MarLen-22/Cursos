# =====================================================================
# Apache configuration for public/ (Front Controller routing)
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si la solicitud no es un archivo físico ni directorio, pasa por index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Bloquear listado de directorios
Options -Indexes

# Bloquear acceso a archivos ocultos (ej. .git, .env)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Compresión GZIP si está disponible
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
